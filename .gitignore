# Local scratch — notes, downloads, experiments. Never committed.
.local/

# Derived. The generator and renderer rebuild these; CI rebuilds them on deploy.
# Without them the build stops and says so, which is correct behaviour, not a bug.
web/data/
site/data/
site/index.html
site/style.css
site/app.js
site/core.js
site/inspect.js
# Generated entity, index and tool pages. site/mockup/ is committed on purpose:
# it is the design the build is checked against, not output.
site/script/
site/lang/
site/font/
site/char/
site/block/
site/feature/
site/scripts/
site/languages/
site/fonts/
site/inspect/
site/regex/
site/identify/
site/compare/

__pycache__/
*.pyc
.venv/
venv/
node_modules/
test-results/
playwright-report/
